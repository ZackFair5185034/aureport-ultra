{
  "name": "aureport-ultra-ui",
  "version": "0.2.0",
  "type": "module",
  "main": "./dist-lib/aureport-ultra.es.js",
  "module": "./dist-lib/aureport-ultra.es.js",
  "types": "./dist-lib/types/lib/index.d.ts",
  "style": "./dist-lib/aureport-ultra.css",
  "exports": {
    ".": {
      "types": "./dist-lib/types/lib/index.d.ts",
      "import": "./dist-lib/aureport-ultra.es.js"
    },
    "./style.css": "./dist-lib/aureport-ultra.css"
  },
  "files": [
    "dist-lib"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:lib": "pnpm build:lib:js && pnpm build:lib:types",
    "build:lib:js": "vite build --config vite.lib.config.ts",
    "build:lib:types": "vue-tsc --project tsconfig.lib.json --declaration --emitDeclarationOnly",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "echo ok"
  },
  "dependencies": {
    "@ckpack/vue-color": "^1.6.0",
    "async-validator": "^4.2.5",
    "axios": "^1.7.0",
    "chart.js": "^4.4.0",
    "chartjs-plugin-datalabels": "^2.2.0",
    "clipboard": "^2.0.11",
    "codemirror": "^5.65.16",
    "handsontable": "^6.2.2",
    "js-beautify": "^1.15.0",
    "pinia": "^3.0.4",
    "raphael": "^2.3.0",
    "save-svg-as-png": "^1.4.17",
    "sortablejs": "^1.15.7",
    "sql-formatter": "^15.7.4",
    "undo-manager": "^1.0.5",
    "uuid": "^10.0.0",
    "vue": "^3.5.0",
    "vue-datepicker-next": "^1.0.3",
    "vue-i18n": "^11.4.4",
    "vue-router": "^5.0.7",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@eslint/js": "^9.22.0",
    "@ffrosch/vue-simple-suggest": "^2.0.7",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.13.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "cross-env": "^7.0.3",
    "esbuild": "~0.27.7",
    "eslint": "^9.22.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-vue": "^9.32.0",
    "sass-embedded": "^1.99.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.26.0",
    "unocss": "^66.0.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^28.0.0",
    "vite": "^8.0.12",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.0"
  }
}
