<?xml version="1.0" encoding="UTF-8"?>
<ureport xmlns="http://www.example.org/ureport2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.example.org/ureport2 http://www.example.org/ureport2">
	<cell expand="None" name="A1" row="1" col="1">
		<simple-value><![CDATA[员工家庭信息表]]></simple-value>
	</cell>
	<cell expand="Down" name="A2" row="2" col="1">
		<dataset-value aggregate="iterate" nest-property="familyMembers" property="name" dataset-name="empBean"></dataset-value>
	</cell>
	<row row-number="1" height="40"/>
	<row row-number="2" height="25"/>
	<column col-number="1" width="80"/>
	<paper type="A4" orientation="portrait" paging-mode="fitpage"></paper>
	<datasource name="empDs" type="spring" bean="employeeService">
		<dataset name="empBean" type="bean" method="queryEmployees">
			<field name="name"/>
			<field name="dept"/>
			<field name="position"/>
			<field name="familyMembers"/>
		</dataset>
	</datasource>
</ureport>
