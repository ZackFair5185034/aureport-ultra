<?xml version="1.0" encoding="UTF-8"?>
<ureport xmlns="http://www.example.org/ureport2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.example.org/ureport2 http://www.example.org/ureport2 ">

    <!-- ========== 报表标题 ========== -->
    <cell expand="None" name="A1" row="1" col="1" col-span="4">
        <simple-value><![CDATA[2024年1月考勤统计表（group属性测试）]]></simple-value>
        <cell-style font-size="16" font-weight="bold" align="center" valign="middle" forecolor="#1a56db"/>
    </cell>

    <!-- ========== 表头 ========== -->
    <cell expand="None" name="A2" row="2" col="1">
        <simple-value><![CDATA[部门]]></simple-value>
        <cell-style font-weight="bold" align="center" valign="middle" background-color="#4f46e5" color="#ffffff"/>
    </cell>
    <cell expand="None" name="B2" row="2" col="2">
        <simple-value><![CDATA[应到人次]]></simple-value>
        <cell-style font-weight="bold" align="center" valign="middle" background-color="#4f46e5" color="#ffffff"/>
    </cell>
    <cell expand="None" name="C2" row="2" col="3">
        <simple-value><![CDATA[正常人次]]></simple-value>
        <cell-style font-weight="bold" align="center" valign="middle" background-color="#4f46e5" color="#ffffff"/>
    </cell>
    <cell expand="None" name="D2" row="2" col="4">
        <simple-value><![CDATA[异常人次]]></simple-value>
        <cell-style font-weight="bold" align="center" valign="middle" background-color="#4f46e5" color="#ffffff"/>
    </cell>

    <!-- ========== 主格：group="dept" 按部门分组 ========== -->
    <!--
        关键：group="dept" 让引擎按 dept 分组，每组一行
        bindData = 该部门的全部考勤记录（10行 for 研发部）
        SQL 已经把统计值算好存在每行里，通过 property 读取
    -->
    <cell expand="Down" name="A3" row="3" col="1" group="dept">
        <dataset-value aggregate="group" property="dept" dataset-name="attendance"/>
        <cell-style font-weight="bold" background-color="#e0e7ff"/>
    </cell>

    <!-- 子格：left-parent-cell="A3" → bindData = A3 的 rowList（该部门全部记录）-->
    <!-- 注意：子格不再设置 expand="Down"，因为它们跟随父格 A3 的展开而展开 -->
    <cell expand="None" name="B3" row="3" col="2" left-parent-cell="A3">
        <dataset-value aggregate="groupstat" property="dept_count" dataset-name="attendance"/>
        <cell-style background-color="#fef3c7" align="center"/>
    </cell>
    <cell expand="None" name="C3" row="3" col="3" left-parent-cell="A3">
        <dataset-value aggregate="groupstat" property="normal_count" dataset-name="attendance"/>
        <cell-style background-color="#d1fae5" align="center"/>
    </cell>
    <cell expand="None" name="D3" row="3" col="4" left-parent-cell="A3">
        <dataset-value aggregate="groupstat" property="abnormal_count" dataset-name="attendance"/>
        <cell-style background-color="#fee2e2" align="center"/>
    </cell>

    <row row-number="1" height="40"/>
    <row row-number="2" height="30"/>
    <row row-number="3" height="25"/>
    <column col-number="1" width="100"/>
    <column col-number="2" width="80"/>
    <column col-number="3" width="80"/>
    <column col-number="4" width="80"/>
    <paper type="A4" orientation="portrait" paging-mode="fitpage"/>

    <datasource name="mysql" type="jdbc" driver="com.mysql.cj.jdbc.Driver"
        username="urp" password="T7nZ7weNG4FBFi75"
        url="jdbc:mysql://192.168.101.188:3306/urp?serverTimezone=Asia/Shanghai&amp;useUnicode=true&amp;characterEncoding=utf-8">

        <!--
            关键：每个分组（部门）的第一行存储统计值，后续行存储明细数据
            SQL 保证每个部门的统计行排在第一位
        -->
        <dataset name="attendance" type="sql">
            <sql><![CDATA[
                SELECT stats.dept, 
                       stats.dept_count, stats.normal_count, stats.abnormal_count,
                       det.id, det.emp_name, det.work_date, det.status,
                       det.clock_in_time, det.clock_out_time
                FROM (
                    SELECT dept,
                           COUNT(*) AS dept_count,
                           SUM(CASE WHEN status='正常' THEN 1 ELSE 0 END) AS normal_count,
                           SUM(CASE WHEN status<>'正常' THEN 1 ELSE 0 END) AS abnormal_count
                    FROM attendance_detail
                    GROUP BY dept
                ) stats
                JOIN attendance_detail det ON stats.dept = det.dept
                ORDER BY stats.dept, det.emp_name, det.work_date
            ]]></sql>
            <field name="dept"/>
            <field name="dept_count"/>
            <field name="normal_count"/>
            <field name="abnormal_count"/>
            <field name="id"/>
            <field name="emp_name"/>
            <field name="work_date"/>
            <field name="status"/>
            <field name="clock_in_time"/>
            <field name="clock_out_time"/>
        </dataset>
    </datasource>
</ureport>