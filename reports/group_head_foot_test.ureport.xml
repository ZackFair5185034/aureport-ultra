<?xml version="1.0" encoding="UTF-8"?>
<ureport xmlns="http://www.example.org/ureport2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.example.org/ureport2 http://www.example.org/ureport2 ">

    <!-- ========== 报表标题 ========== -->
    <cell expand="None" name="A1" row="1" col="1" col-span="4">
        <simple-value><![CDATA[部门考勤统计表（分组表头表尾测试）]]></simple-value>
        <cell-style font-size="16" font-weight="bold" align="center" valign="middle" forecolor="#1a56db"/>
    </cell>

    <!-- ========== 分组表头行（第2行）：显示分组名称 ========== -->
    <!--
        关键配置：
        - aggregate="grouphead" → 使用 GroupHeadAggregate 处理器
        - property="dept" → 从数据中取 dept 字段作为表头显示文本
        - group-head="true" → 标记为分组表头单元格（用于 HtmlProducer 添加 CSS 类）
    -->
    <cell expand="None" name="A2" row="2" col="1" col-span="4" group="dept">
        <dataset-value aggregate="grouphead" property="dept" dataset-name="attendance" group-head="true"/>
        <cell-style font-weight="bold" background-color="#e0e7ff" font-size="14"/>
    </cell>

    <!-- ========== 明细行（第3行） ========== -->
    <cell expand="Down" name="A3" row="3" col="1" left-parent-cell="A2">
        <dataset-value aggregate="select" property="emp_name" dataset-name="attendance"/>
        <cell-style align="center"/>
    </cell>
    <cell expand="None" name="B3" row="3" col="2" left-parent-cell="A2">
        <dataset-value aggregate="select" property="work_date" dataset-name="attendance"/>
        <cell-style align="center"/>
    </cell>
    <cell expand="None" name="C3" row="3" col="3" left-parent-cell="A2">
        <dataset-value aggregate="select" property="status" dataset-name="attendance"/>
        <cell-style align="center"/>
    </cell>
    <cell expand="None" name="D3" row="3" col="4" left-parent-cell="A2">
        <dataset-value aggregate="select" property="clock_in_time" dataset-name="attendance"/>
        <cell-style align="center"/>
    </cell>

    <!-- ========== 分组表尾行（第4行）：显示分组统计 ========== -->
    <!--
        关键配置：
        - aggregate="groupfoot" → 使用 GroupFootAggregate 处理器
        - property="emp_name" → 对 emp_name 字段计数（统计该部门人数）
        - group-foot="true" → 标记为分组表尾单元格
        - sub-aggregate="count" → 子聚合类型为计数
    -->
    <cell expand="None" name="A4" row="4" col="1" col-span="2" group="dept">
        <dataset-value aggregate="groupfoot" property="emp_name" dataset-name="attendance" group-foot="true" sub-aggregate="count"/>
        <cell-style font-weight="bold" background-color="#fef3c7"/>
    </cell>
    <cell expand="None" name="B4" row="4" col="2" col-span="2">
        <simple-value><![CDATA[部门合计人次]]></simple-value>
        <cell-style font-weight="bold" background-color="#fef3c7" align="right"/>
    </cell>
    <cell expand="None" name="C4" row="4" col="3" left-parent-cell="A4">
        <dataset-value aggregate="groupfoot" property="emp_name" dataset-name="attendance" group-foot="true" sub-aggregate="count"/>
        <cell-style font-weight="bold" background-color="#fef3c7" align="center"/>
    </cell>

    <row row-number="1" height="40"/>
    <row row-number="2" height="30"/>
    <row row-number="3" height="25"/>
    <row row-number="4" height="30"/>
    <column col-number="1" width="100"/>
    <column col-number="2" width="100"/>
    <column col-number="3" width="100"/>
    <column col-number="4" width="100"/>
    <paper type="A4" orientation="landscape" paging-mode="fitpage"/>

    <datasource name="mysql" type="jdbc" driver="com.mysql.cj.jdbc.Driver"
        username="urp" password="T7nZ7weNG4FBFi75"
        url="jdbc:mysql://192.168.101.188:3306/urp?serverTimezone=Asia/Shanghai&amp;useUnicode=true&amp;characterEncoding=utf-8">

        <!--
            测试数据：按部门分组，每个部门有 2-3 条考勤记录
            grouphead 显示部门名称
            groupfoot 显示该部门的记录总数
        -->
        <dataset name="attendance" type="sql">
            <sql><![CDATA[
                SELECT dept, emp_name, work_date, status, clock_in_time, clock_out_time
                FROM attendance_detail
                ORDER BY dept, emp_name, work_date
            ]]></sql>
            <field name="dept"/>
            <field name="emp_name"/>
            <field name="work_date"/>
            <field name="status"/>
            <field name="clock_in_time"/>
            <field name="clock_out_time"/>
        </dataset>
    </datasource>
</ureport>