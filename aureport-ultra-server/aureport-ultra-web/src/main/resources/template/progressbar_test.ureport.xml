<?xml version="1.0" encoding="UTF-8"?>
<ureport xmlns="http://www.example.org/ureport2">
	<cell name="A1" row="1" col="1" col-span="3">
		<simple-value>进度条单元格测试报表</simple-value>
		<cell-style font-size="16" font-weight="bold" align="center" forecolor="#FFFFFF" background-color="#409EFF"></cell-style>
	</cell>

	<cell name="A2" row="2" col="1">
		<simple-value>项目名称</simple-value>
		<cell-style font-weight="bold" align="center" background-color="#F5F7FA"></cell-style>
	</cell>
	<cell name="B2" row="2" col="2">
		<simple-value>进度值</simple-value>
		<cell-style font-weight="bold" align="center" background-color="#F5F7FA"></cell-style>
	</cell>
	<cell name="C2" row="2" col="3">
		<simple-value>百分比</simple-value>
		<cell-style font-weight="bold" align="center" background-color="#F5F7FA"></cell-style>
	</cell>

	<cell name="A3" row="3" col="1">
		<simple-value>项目进度</simple-value>
	</cell>
	<cell name="B3" row="3" col="2">
		<progressbar-value min-value="0" max-value="100" current-value="75" bar-color="#67C23A" bg-color="#E4E7ED"/>
	</cell>
	<cell name="C3" row="3" col="3">
		<simple-value>75%</simple-value>
		<cell-style align="center"></cell-style>
	</cell>

	<cell name="A4" row="4" col="1">
		<simple-value>销售目标</simple-value>
	</cell>
	<cell name="B4" row="4" col="2">
		<progressbar-value min-value="0" max-value="100" current-value="65" bar-color="#409EFF" bg-color="#E4E7ED"/>
	</cell>
	<cell name="C4" row="4" col="3">
		<simple-value>65%</simple-value>
		<cell-style align="center"></cell-style>
	</cell>

	<cell name="A5" row="5" col="1">
		<simple-value>完成率</simple-value>
	</cell>
	<cell name="B5" row="5" col="2">
		<progressbar-value min-value="0" max-value="100" current-value="85" bar-color="#E6A23C" bg-color="#E4E7ED"/>
	</cell>
	<cell name="C5" row="5" col="3">
		<simple-value>85%</simple-value>
		<cell-style align="center"></cell-style>
	</cell>
</ureport>