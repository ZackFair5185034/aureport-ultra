<?xml version="1.0" encoding="UTF-8"?>
<ureport xmlns="http://www.example.org/ureport2">
	<cell expand="None" name="A1" row="1" col="1" col-span="3">
		<simple-value>富文本单元格测试报表</simple-value>
		<cell-style font-size="18" font-weight="bold" align="center" forecolor="#FF0000"></cell-style>
	</cell>

	<cell expand="None" name="A2" row="2" col="1">
		<simple-value>标签</simple-value>
		<cell-style font-weight="bold" background-color="#e0e7ff" align="center"></cell-style>
	</cell>
	<cell expand="None" name="B2" row="2" col="2" col-span="2">
		<simple-value>富文本值</simple-value>
		<cell-style font-weight="bold" background-color="#e0e7ff" align="center"></cell-style>
	</cell>

	<cell expand="None" name="A3" row="3" col="1">
		<simple-value>加粗文本：</simple-value>
	</cell>
	<cell expand="None" name="B3" row="3" col="2" col-span="2">
		<richtext-value><![CDATA[<b>这是一段加粗的文字</b>]]></richtext-value>
	</cell>

	<cell expand="None" name="A4" row="4" col="1">
		<simple-value>斜体文本：</simple-value>
	</cell>
	<cell expand="None" name="B4" row="4" col="2" col-span="2">
		<richtext-value><![CDATA[<i>这是一段斜体的文字</i>]]></richtext-value>
	</cell>

	<cell expand="None" name="A5" row="5" col="1">
		<simple-value>彩色文本：</simple-value>
	</cell>
	<cell expand="None" name="B5" row="5" col="2" col-span="2">
		<richtext-value><![CDATA[<span style="color:red">红色文字</span>]]></richtext-value>
	</cell>

	<cell expand="None" name="A6" row="6" col="1">
		<simple-value>混合样式：</simple-value>
	</cell>
	<cell expand="None" name="B6" row="6" col="2" col-span="2">
		<richtext-value><![CDATA[<b><i><span style="color:#0066CC">加粗+斜体+蓝色</span></i></b>]]></richtext-value>
	</cell>

	<cell expand="None" name="A7" row="7" col="1">
		<simple-value>XSS防护：</simple-value>
	</cell>
	<cell expand="None" name="B7" row="7" col="2" col-span="2">
		<richtext-value><![CDATA[<script>alert('xss')</script>]]></richtext-value>
	</cell>

	<row row-number="1" height="40"/>
	<row row-number="2" height="30"/>
	<row row-number="3" height="30"/>
	<row row-number="4" height="30"/>
	<row row-number="5" height="30"/>
	<row row-number="6" height="30"/>
	<row row-number="7" height="30"/>

	<column col-number="1" width="120"/>
	<column col-number="2" width="300"/>
	<column col-number="3" width="100"/>
</ureport>