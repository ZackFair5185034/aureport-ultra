<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.aureport.ultra</groupId>
    <artifactId>aureport-ultra-server</artifactId>
    <version>1.0.0</version>
  </parent>
  <groupId>com.aureport.ultra</groupId>
  <artifactId>aureport-ultra-font</artifactId>
  <version>1.0.0</version>
  <name>UReport2 Font Project</name>
  <url>https://github.com/youseries/ureport/tree/master/ureport2-font</url>
  <dependencies>
    <dependency>
      <groupId>com.aureport.ultra</groupId>
      <artifactId>aureport-ultra-core</artifactId>
      <version>${revision}</version>
    </dependency>
  </dependencies>
  <build>
    <resources>
      <resource>
        <directory>src/main/java</directory>
        <includes>
          <include>**/*.ttf</include>
          <include>**/*.ttc</include>
          <include>**/*.TTF</include>
          <include>**/*.TTC</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
    </resources>
  </build>
</project>
